{
    "name": "catalog",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "nx serve --no-hmr --live-reload=false",
        "build": "nx build",
        "watch": "nx build --watch --configuration development",
        "test": "nx test",
        "build-gh": "nx build --output-path docs --base-href /LiveStock-Inventory/",
        "postbuild-gh": "mv ./docs/browser/* ./docs/",
        "build-netlify": "nx build --output-path docs --base-href /",
        "postbuild-netlify": "mv ./docs/browser/* ./docs/"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "~20.2.10",
        "@angular/common": "~20.3.0",
        "@angular/compiler": "~20.3.0",
        "@angular/core": "~20.3.0",
        "@angular/forms": "~20.3.0",
        "@angular/platform-browser": "~20.3.0",
        "@angular/router": "~20.3.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "~2.1.2",
        "@analogjs/vitest-angular": "~2.1.2",
        "@angular-devkit/core": "~20.3.8",
        "@angular-devkit/schematics": "~20.3.8",
        "@angular/build": "~20.3.8",
        "@angular/cli": "~20.3.8",
        "@angular/compiler-cli": "~20.3.0",
        "@nx/angular": "21.6.6",
        "@nx/js": "22.3.3",
        "@nx/vite": "22.3.3",
        "@nx/vitest": "^22.3.3",
        "@nx/workspace": "21.6.6",
        "@schematics/angular": "~20.3.8",
        "@swc-node/register": "~1.9.1",
        "@swc/core": "~1.5.7",
        "@swc/helpers": "~0.5.11",
        "@types/jasmine": "~5.1.0",
        "@types/node": "20.19.9",
        "@vitest/coverage-v8": "^3.0.5",
        "@vitest/ui": "^3.0.0",
        "jasmine-core": "~5.9.0",
        "jsdom": "^27.4.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "nx": "21.6.6",
        "prettier": "~3.6.2",
        "typescript": "~5.9.2",
        "vite": "^7.0.0",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "@angular/compiler": "$@angular/compiler",
        "@angular/compiler-cli": "$@angular/compiler-cli",
        "@angular/core": "$@angular/core",
        "@angular/common": "$@angular/common",
        "@angular/platform-browser": "$@angular/platform-browser",
        "@angular-devkit/build-angular": "20.3.9"
    }
}
